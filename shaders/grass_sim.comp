#version 460 core
// Per-blade spring-damper, one invocation per blade. State (bend, velocity) stays on the
// GPU between frames. Must match GrassSim::stepCpu() in grass_sim.cpp.
// PACKED_LAYOUT: static data and bends use the 16 B / half2 encodings.

layout(local_size_x = 256) in;

#ifdef PACKED_LAYOUT
layout(std430, binding = 0) readonly buffer Statics { uvec4 statics[]; };
layout(std430, binding = 1) buffer Bends { uint bends[]; };
#else
struct StaticBlade { vec4 a; vec4 b; };
layout(std430, binding = 0) readonly buffer Statics { StaticBlade statics[]; };
layout(std430, binding = 1) buffer Bends { vec2 bends[]; };
#endif
layout(std430, binding = 2) buffer Velocities { vec2 velocities[]; };
layout(std430, binding = 3) buffer Result { uint flattenedCount; };

uniform uint uCount;
uniform float uTime;
uniform float uDt;
uniform vec2 uWindDir;
uniform float uWindStrength;
uniform float uStiffness;
uniform float uDamping;
uniform vec2 uTrampleCenter;
uniform float uTrampleRadius; // 0 = off
uniform float uTrampleStrength;

const float kMaxBend = 1.5;
const float kFlattenedThreshold = 0.6;

float windSway(vec2 rootXZ) {
    float phase = uTime * 1.7 + dot(rootXZ, vec2(0.13, 0.09));
    return (0.5 + 0.35 * sin(phase) + 0.15 * sin(phase * 2.3 + 1.0)) * uWindStrength;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uCount) return;

#ifdef PACKED_LAYOUT
    uvec4 s = statics[i];
    vec2 root = uintBitsToFloat(s.xy);
    float yaw = float(s.z & 0xFFFFu) / 65535.0 * 6.2831853;
    float restBend01 = float(s.z >> 24) / 255.0;
    vec2 bend = unpackHalf2x16(bends[i]);
#else
    StaticBlade s = statics[i];
    vec2 root = s.a.xy;
    float yaw = s.a.z * 6.2831853;
    float restBend01 = s.b.z;
    vec2 bend = bends[i];
#endif
    vec2 rest = vec2(sin(yaw), cos(yaw)) * (0.5 * restBend01);
    vec2 velocity = velocities[i];

    // The spring pulls towards the rest pose plus wind; trampling pushes away from the sphere.
    vec2 target = rest + uWindDir * windSway(root);
    vec2 force = uStiffness * (target - bend) - uDamping * velocity;
    vec2 away = root - uTrampleCenter;
    float dist = length(away);
    if (dist < uTrampleRadius && dist > 1e-4) {
        force += away / dist * (uTrampleStrength * (1.0 - dist / uTrampleRadius));
    }

    // Semi-implicit Euler.
    velocity += force * uDt;
    bend += velocity * uDt;
    float len = length(bend);
    if (len > kMaxBend) {
        bend *= kMaxBend / len;
        velocity *= 0.5;
    }

#ifdef PACKED_LAYOUT
    bends[i] = packHalf2x16(bend);
#else
    bends[i] = bend;
#endif
    velocities[i] = velocity;
    if (length(bend - rest) > kFlattenedThreshold) atomicAdd(flattenedCount, 1u);
}
